/** One material's row inside a step: what it is, why this way, and the
*  ways the plan could not count. */
function wayRow(l) {
const door = l.kind === 'S' ? `<button class="S" data-act="S" data-item="S">${('S')}</button>`S`<button class="S" data-act="S" data-item="S">${('S')}</button>`S`<div class="S">${('S', { n: F(l.coins) })}</div>`S`<div class="S">${('S', { n: FC(l.silver) })}</div>`S`<div class="S">
${Object.entries(recipe).map(([ing, per]) => `<span class="S" data-peek="S">${img(ing, 'S')}${F(per)}×</span>`).join('S')}
<span class="S">${esc(how ? (how) : ('S'))}${makes > 1 ? ` · ${('S', { n: F(makes) })}` : 'S'} · ${Math.ceil(l.qty / makes) === 1 ? ('S', { n: F(Math.ceil(l.qty / makes)) }) : ('S', { n: F(Math.ceil(l.qty / makes)) })}</span>
</div>`S`<div class="S" data-peek="S">
${img(l.item, 'S')}
<div class="S">
<div class="S">${codexName(l.item)}</div>
${lines.map((line, i) => `<div class="S">${esc([i === 0 ? l.unit : 'S', line].filter(Boolean).join('S'))}${i === lines.length - 1 && door ? ` · ${door}`S`).join('S')}
${l.also ? `<div class="S">${('S', { text: esc(l.also) })}</div>` : 'S'}
${strip}
</div>
${shop}
<div class="S">
<div class="S">${F(Math.ceil(l.qty))}</div>
${cost}
</div>
</div>`S`<div class="S"><p class="S">${!way ? ('S') : ('S')}</p></div>`S`${(meta.sub)} ${('S', { draws, days: dayWord(way.days) })}`S`step-${g.kind}`S`<div class="S">${esc(coinFoot(way))}</div>`S`<div class="S">
${img(CROW_COIN, 'S')}
<div class="S">
<div class="S">${('S')}</div>
<div class="S">${('S')}</div>
</div>
<div class="S"><div class="S">${F(way.coins.income)}</div></div>
