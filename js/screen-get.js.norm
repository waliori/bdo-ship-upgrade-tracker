${stepHead(n, meta.tone, (meta.title), sub, stepTotal(g), id)}
${folded.has(id) ? 'S' : `<div class="S">${g.items.map(wayRow).join('S')}${foot}</div>`S`;
}).join('S');
const head = planHead(way, steps, things);
if (q && !legs.length && !questsHTML) return head + `<div class="S"><p class="S">${('S')}</p></div>`S`<div class="S">
<span class="S">${questsHTML ? ('S') : ('S')}</span>
<i></i>
