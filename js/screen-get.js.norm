</div>`S`change`S` — ${('S', { n: F(g.coins) })}`S` — ${('S', { n: F(g.silver) })}`S`  ${Math.round(e.qty)}× ${(e.item)}`S`${g.key}${total}\n${lines.join('S')}`;
}).join('S');
}
/**
* The same list for a spreadsheet: one row a line, the group it sits
* under, the quantity, what one costs, and the note the row shows
* (where it is bought, or that it is bartered). Quoted the way RFC 4180
* asks, so a name with a comma in it stays one cell.
*/
export function shoppingCSV() {
const cell = v => {
const t = String(v == null ? 'S' : v);
return /["S"${t.replace(/"S"` : t;
};
const rows = [[('S'), ('S'), ('S'), ('S'), ('S')]];
if (getMode() === 'S') {
const way = theWay();
for (const g of (way ? way.groups : [])) {
for (const l of g.items) {
const each = l.qty ? (l.coins ? ('S', { n: Math.round(l.coins / l.qty) }) : l.silver ? ('S', { n: Math.round(l.silver / l.qty) }) : 'S') : 'S';
rows.push([(g.label), (l.item), Math.ceil(l.qty), each, [l.why, l.also ? ('S', { text: l.also }) : 'S'].filter(Boolean).join('S')]);
}
}
return rows.map(r => r.map(cell).join('S')).join('S');
}
for (const g of visibleGroups(query.toLowerCase())) {
for (const e of [...g.items].sort((a, b) => b.qty - a.qty)) {
const each = e.qty ? (e.coins ? ('S', { n: Math.round(e.coins / e.qty) }) : e.silver ? ('S', { n: Math.round(e.silver / e.qty) }) : 'S') : 'S';
const note = e.detail || (e.barter ? ('S', { n: e.barter.npcs.length }) : e.market ? ('S') : 'S');
rows.push([g.key, (e.item), Math.round(e.qty), each, note]);
}
}
return rows.map(r => r.map(cell).join('S')).join('S');
}