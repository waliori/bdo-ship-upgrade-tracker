# Sync is optional. With none of this set, the tracker is the browser-only
# tool it has always been: no account, no database, nothing leaves the
# machine. Fill this in only if you want one inventory across devices.
#
# Copy to .env and fill in. It is read automatically by both `npm start`
# and `docker compose up` -- nothing else to wire.
#
# .env is gitignored and excluded from the Docker build context, so the
# secrets never reach the repository and are never baked into an image;
# compose hands them to the container at run time instead. Keep it that
# way -- the client secret and the database token are both credentials.

# ---- Where this deployment answers -------------------------------------
# Used to build the OAuth redirect, so it must match what is registered
# with Discord exactly: scheme, host and port. Defaults to
# http://localhost:8000 when unset, which is right for local development.
PUBLIC_URL=https://sail.walior.it

# ---- Discord -----------------------------------------------------------
# From https://discord.com/developers/applications -> your app -> OAuth2.
# Register the redirect there as PUBLIC_URL + /auth/discord/callback, and
# add http://localhost:8000/auth/discord/callback too if you develop
# locally -- Discord allows several.
#
# The app asks for the `identify` scope and nothing else: an account id to
# file the save under, and a name to show in the header.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Database ----------------------------------------------------------
# From `turso db show <name> --url` and `turso db tokens create <name>`.
# For local development a plain file works and needs no account or token:
#   TURSO_DATABASE_URL=file:./.data/tracker.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Sessions ----------------------------------------------------------
# Signs the session cookie. Any long random string; generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the server invents one at boot and says so, which means every
# restart signs everyone out.
SESSION_SECRET=

# ---- Push reminders (optional) ------------------------------------------
# The sailing clock's chimes on every device signed in, tab open or not.
# Needs sign-in (the database and Discord above) and a key pair:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT is who to contact about the pushes: a mailto: or the site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# The community bot's token. With it, a sailor can ask for each chime as a
# Discord message too (needs the VAPID keys above and sign-in).
# DISCORD_BOT_TOKEN=
# The bot application's public key (General Information page). With it the
# server answers /ship and /sailors at /api/discord/interactions -- paste that
# address into the bot application's Interactions Endpoint URL.
# DISCORD_BOT_PUBLIC_KEY=

# ---- Feedback and the community boards (optional) ----------------------
# More -> Feedback lands in a table wherever there is a database. A Discord
# webhook (server settings -> Integrations -> Webhooks) gets a copy of
# each entry the moment it lands, so you hear of a bug without opening
# the inbox. The inbox itself is on the More menu for the Discord account
# ids listed here, comma-separated.
# FEEDBACK_WEBHOOK_URL=
# ADMIN_IDS=
# A report can carry screenshots. The bytes go on disk rather than into
# the database; this is where, and the default is inside the same .data
# the local database file lives in -- which the compose volume already
# covers, so images survive a rebuild. Set FEEDBACK_IMAGES=0 to take the
# attach button away entirely.
# UPLOAD_DIR=./.data/uploads
# FEEDBACK_IMAGES=1
# What one report may carry, and how often an account may send one.
# MAX_FILES_PER_ENTRY=4
# MAX_IMAGE_BYTES=4194304
# IMAGE_PIXELS=1600
# MAX_OPEN_REPORTS=4
# MAX_REPORTS_PER_DAY=10
# REPORT_GAP_SECONDS=60
# An image uploaded for a report that was never sent is swept after this.
# UPLOAD_TTL_HOURS=24
# All the pictures on disk together. Past it the box takes no more images
# (the words still send) until some are swept or thrown away.
# MAX_UPLOAD_BYTES=2147483648
# The Community tab needs sign-in and comes with it. Signing in puts
# nobody on the boards: the tab asks once, and the answer -- by name,
# unnamed, or no -- is remembered.
# A quiet board is rebuilt at most this often...
# COMMUNITY_TTL_MS=300000
# ...and one where somebody on it has saved, this often, so a ship
# fitted on the Ship tab is on the boards seconds later.
# COMMUNITY_REBUILD_MS=3000

# ---- Release notes and backups (tools, not the server) -----------------
# The webhook of the Discord channel tools/post-release-notes.mjs posts a
# release's notes to. Read only by that tool.
# DISCORD_RELEASES_WEBHOOK=
# How often the backup service in docker-compose.yml (the `backup`
# profile) writes a backup, in hours.
# BACKUP_EVERY_HOURS=24

# ---- Optional ----------------------------------------------------------
# PORT=8000
# The host address the container's port is published on. The default takes
# every interface; with the proxy on the same machine, 127.0.0.1 keeps the
# app reachable only through it -- which CLIENT_IP_HEADER below relies on.
# BIND=127.0.0.1
# The header the proxy puts the player's own address in, for the limits
# kept per address (link opens, the market, pushes, the boards). Behind
# Cloudflare it is cf-connecting-ip. Leave it unset when the app can be
# reached directly: a caller could then write the header themselves.
# CLIENT_IP_HEADER=cf-connecting-ip
# SESSION_DAYS=30
# MAX_SAVE_BYTES=1048576
# Names the build: the offline cache is called after it, so it must change
# with every deploy. Unset, the server uses the git commit, then the stamp
# the Docker build wrote, then the package version and start time.
# APP_VERSION=
# One JSON line per API request on stdout. 0 turns it off.
# LOG_REQUESTS=1

# ---- Sync performance --------------------------------------------------
# All of these have working defaults. They are here because the shape of
# the sync path is worth knowing, not because anything needs setting.
#
# A push is answered from memory and written out to Turso just behind the
# request, so the browser never waits on the database. This is how long a
# change is held before being written -- long enough that typing "1",
# "12", "120" into a quantity is one write instead of three.
# FLUSH_DELAY_MS=400

# A `libsql://` URL is HTTP underneath, so every statement rides on a
# pooled connection. Node closes an idle one after four seconds by
# default, which for this app means most saves pay for a fresh DNS
# lookup, TCP handshake and TLS handshake -- and it is that cold connect
# that shows up as `fetch failed / ETIMEDOUT` from inside a container.
# Holding the connection open is the fix.
# TURSO_KEEPALIVE_MS=60000
# TURSO_CONNECTIONS=8
# TURSO_CONNECT_MS=5000
# TURSO_TIMEOUT_MS=10000
# TURSO_RETRIES=4

# Most containers have no route to the IPv6 internet but still get AAAA
# records back, and a SYN sent down that route is never answered rather
# than refused. These are how long to wait before trying the IPv4 address
# instead, and whether to ask for the v6 one at all. Set DNS_RESULT_ORDER
# to `verbatim` to leave name resolution alone.
# TURSO_FAMILY_MS=500
# DNS_RESULT_ORDER=ipv4first

# How many accounts' saves are held in memory. Only accounts with nothing
# left to write are ever dropped.
# CACHE_ACCOUNTS=5000
# CACHE_BYTES=134217728

# Pushes allowed per account per minute. The client coalesces rapid edits,
# so its own ceiling is about 120 a minute; this leaves room above that for
# a retry or a second tab. Address-level limits belong on the proxy.
# MAX_PUSHES_PER_MINUTE=600

# ---- Sharing, the fleet's boards, presence -----------------------------
# A kept link (#s/<id>): how many an account may make a minute, what one
# may carry, how many it keeps and how much they weigh between them -- past
# either, the oldest go.
# MAX_LINKS_PER_MINUTE=20
# MAX_LINK_BYTES=262144
# MAX_LINKS_PER_ACCOUNT=2000
# MAX_LINK_BYTES_PER_ACCOUNT=16777216
# Barter boards told to the fleet, per account per minute.
# MAX_BOARDS_PER_MINUTE=20
# The "sailors about" count. 0 turns it off.
# PRESENCE=1
# Push subscriptions held in all, signed in or not.
# PUSH_MAX_SUBSCRIPTIONS=10000
