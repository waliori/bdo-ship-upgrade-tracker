{
  "name": "bdo-ship-upgrade-tracker",
  "version": "1.0.0",
  "description": "Track Black Desert Online ship upgrades against one shared inventory",
  "author": "waliori",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://sail.walior.it/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waliori/bdo-ship-upgrade-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/waliori/bdo-ship-upgrade-tracker/issues"
  },
  "keywords": [
    "black-desert-online",
    "bdo",
    "ship-upgrade",
    "tracker"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.js",
    "build": "echo 'No build process needed - static files'",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test \"test/*.test.mjs\"",
    "check": "node --env-file-if-exists=.env tools/check-env.mjs",
    "backup": "node --env-file-if-exists=.env tools/backup.mjs",
    "restore": "node --env-file-if-exists=.env tools/backup.mjs --restore",
    "capture": "tools/capture/shoot.sh",
    "lint": "eslint ."
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "undici": "^7.29.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "puppeteer-core": "^25.9.0"
  }
}
