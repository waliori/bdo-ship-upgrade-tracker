.git
.github
node_modules
# The README's full-size stills and GIFs are not served. What the app
# itself asks for is: the walkthrough films, and the narrow copies the
# What's New dialog shows.
docs/**
!docs/media/*.mp4
!docs/media/*.vtt
!docs/media/small
!docs/media/small/*
# The phone cut of the walkthrough: the capture tools write it, nothing
# in the app plays it.
docs/media/walkthrough-phone.mp4
# The English catalogue the translators work from. The app never fetches
# it -- English is the words in the code -- and the tests read it from
# the checkout, not from the image.
js/lang/en.json
tools/**
# The backup tool, for the scheduled backup service.
!tools/backup.mjs
*.md
!README.md
.env
.env.local
.data
test
